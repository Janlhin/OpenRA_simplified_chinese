## ingame-player.yaml
supportpowers-support-powers-palette =
    .ready = 就绪
    .hold = 待命

button-command-bar-attack-move =
    .tooltip = 攻击移动
    .tooltipdesc =
    所选单位会前往指定位置,
    并攻击途中遇到的任何敌人。

    按住 <(Ctrl)> 指定目标可下达突击移动命令,
    攻击途中遇到的任何单位或建筑。

    左键点击图标,然后在目标位置右键点击。

button-command-bar-guard =
    .tooltip = 护卫
    .tooltipdesc =
    所选单位将跟随指定单位。

    左键点击图标,然后在目标单位上右键点击。

button-command-bar-scatter =
    .tooltip = 散开
    .tooltipdesc =
    所选单位会中止当前行动,
    并移动到附近位置。

    对所选单位立即生效。

button-command-bar-stop =
    .tooltip = 停止
    .tooltipdesc =
    所选单位会中止当前行动。
    所选建筑会重置集结点。

    对所选目标立即生效。

button-command-bar-queue-orders =
    .tooltip = 路径点模式
    .tooltipdesc =
    使用路径点模式可向所选单位下达
    多个连贯命令。单位会在接到命令后
    立即执行。

    左键点击图标,然后在地图上依次下达命令。
    下达命令时按住 <(Shift)> 可临时启用。

button-stance-bar-attackanything =
    .tooltip = 主动攻击姿态
    .tooltipdesc =
    将所选单位设为主动攻击姿态:
     - 单位会对视野内的敌方单位与建筑发起攻击
     - 单位会追击战场上的攻击者

button-stance-bar-defend =
    .tooltip = 防守姿态
    .tooltipdesc =
    将所选单位设为防守姿态:
     - 单位会对视野内的敌方单位发起攻击
     - 单位不会移动或追击敌人

button-stance-bar-returnfire =
    .tooltip = 还击姿态
    .tooltipdesc =
    将所选单位设为还击姿态:
     - 单位会反击攻击自己的敌人
     - 单位不会移动或追击敌人

button-stance-bar-holdfire =
    .tooltip = 停火姿态
    .tooltipdesc =
    将所选单位设为停火姿态:
     - 单位不会向敌人开火
     - 单位不会移动或追击敌人

