actor-fact =
    .name = 建筑工厂
    .description = 建造建筑。
    .encyclopedia =
    任何基地的核心。它生产建筑与防御设施，同时提供建造半径。它拥有很高的生命值，但难以补充，因此必须严加防守。

    使用展开键可以把它打包成移动形态，但这需要一点时间。

actor-fact-gdi-name = GDI 建造厂
actor-fact-nod-name = Nod 建造厂

actor-nuke =
    .name = 发电厂
    .description = 产生电力。
    .encyclopedia =
    为基地内的建筑提供电力。发电量直接取决于发电厂的状态，因此战斗中要保护好它们。

actor-nuk2 =
    .name = 大型发电厂
    .description =
    提供更多电力，且比
    标准发电厂更便宜。
    .encyclopedia =
    为基地内的建筑提供更多电力，因此比发电厂更具性价比。发电量直接取决于它的状态，战斗中要保护好它。

actor-proc =
    .name = 泰伯利亚精炼厂
    .description =
    把原矿泰伯利亚
    加工成可用资源。
    .encyclopedia =
    储存并加工外星物质与资源——泰伯利亚。采集车在野外采集泰伯利亚后把它卸到精炼厂，在那里转化为信用点。

    精炼厂可储存泰伯利亚，建成后会立即配发一辆采集车。就近精炼时最多可同时服务 3 辆采集车。

actor-silo =
    .name = 泰伯利亚矿仓
    .description = 储存加工后的泰伯利亚。
    .encyclopedia =
    储存信用点。若储存已满，采集车会一直等待，直到信用点被花掉。

    在采集价值更高的蓝色泰伯利亚时很有用，因为单座精炼厂装不下一次满载的量。

actor-pyle =
    .name = GDI兵营
    .description = 训练步兵。
    .encyclopedia =
    为 GDI 生产步兵。解锁后，GDI 的高级步兵打击力强且速度很快。

actor-hand =
    .name = Nod之手
    .description = 训练步兵。
    .encyclopedia =
    为 Nod 生产步兵。解锁后，Nod 的高级步兵移动较慢，但生命值很高。

actor-afld =
    .name = 战地跑道
    .description =
    提供车辆增援的
    空投场地。
    .encyclopedia =
    用运输机为 Nod 投送车辆。Nod 车辆速度快但脆弱。开局先造采集车，能迅速启动经济。

actor-weap =
    .name = 战车工厂
    .description = 生产车辆。
    .encyclopedia =
    为 GDI 生产车辆。GDI 车辆通常较慢但打击力强。开局先造采集车，能迅速启动经济。

actor-hpad =
    .name = 停机坪
    .description =
    生产并维修直升机。
    .encyclopedia =
    生产并维修直升机。建造高级攻击直升机需要通讯中心。

actor-hq =
    .name = 通讯中心
    .description =
    提供雷达与空袭支援技能。
    解锁更高科技的单位的建筑。
    需要电力才能运作。
    .airstrikepower-name = 空袭
    .airstrikepower-description = 发动一次空中凝固汽油弹打击。
    沿一条直线烧毁建筑与步兵。
    .encyclopedia =
    在电力充足时让玩家获得小地图（右上角）。解锁新单位，并授予空袭支援技能。

actor-fix =
    .name = 维修平台
    .description = 维修车辆。
    .encyclopedia =
    维修车辆。可以对单位使用维修指令，把它们送往最近的维修厂。

actor-eye =
    .name = 高级通讯中心
    .description =
    提供雷达与轨道离子炮支援技能。
    解锁猛犸坦克与特种兵。
    需要电力才能运作。
    .ioncannonpower-name = 离子炮
    .ioncannonpower-description = 发动一次离子炮打击。
    对小块区域造成即时伤害。
    .encyclopedia =
    解锁高级单位与离子炮支援技能。若通讯中心被摧毁，它也能恢复小地图功能与单位生产。

actor-tmpl =
    .name = Nod神庙
    .description =
    提供核打击支援技能。
    解锁隐形坦克、化学战士与光明方尖碑。
    需要电力才能运作。
    .nukepower-name = 核打击
    .nukepower-description = 发射一枚战术核弹头。
    对大片区域造成严重伤害。
    .encyclopedia =
    解锁高级单位与核弹支援技能。若通讯中心被摧毁，它能让单位的解锁状态保持有效。

actor-gun =
    .name = 反坦克炮塔
    .description =
    基础反坦克基地防御。
      对坦克与车辆强
      对步兵弱
    .encyclopedia =
    装备穿甲炮的基地防御设施，对射程内的车辆造成可观伤害。

actor-sam =
    .name = 防空导弹阵地
    .description =
    对空基地防御。
      对飞行器强
      无法瞄准地面单位
    .encyclopedia =
    Nod 的对空基地防御。收起时受到保护，打开时攻击飞行器。

actor-obli =
    .name = 光明石碑
    .description =
    高级基地防御。
    需要电力才能运作。
      对所有地面单位强
      无法瞄准飞行器
    .encyclopedia =
    Nod 的高级防御设施，用强力激光迅速摧毁地面目标。

actor-gtwr =
    .name = 机枪哨塔
    .description =
    基础防御建筑。
      对步兵强
      对坦克弱
    .encyclopedia =
    装备高速机枪的基地防御设施，凭借较大的杀伤范围撕裂射程内的步兵与轻型车辆。

actor-atwr =
    .name = 先进导弹塔
    .description =
    全能防御建筑。
      对飞行器与步兵强
      对坦克弱
    .encyclopedia =
    GDI 的高级防御设施，向地面与空中目标齐射高爆导弹。对各种目标都有效。

actor-sbag =
    .name = 沙袋
    .description =
    阻挡步兵与轻型车辆。
      可被坦克碾压。
    .encyclopedia =
    阻挡步兵与轻型车辆的移动，但会被坦克碾压。对轻武器免疫。

    放置好第一段沙袋后，这种路障可以连续建造多段。

actor-cycl =
